// ──────────────────────────────────────────────────────────────
// SwarShala — Prisma Schema (PostgreSQL, single-DB multi-tenant)
// ──────────────────────────────────────────────────────────────
generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

// ── Tenants ─────────────────────────────────────────────────
model Tenant {
    id        String   @id @default(uuid()) @db.Uuid
    slug      String   @unique @db.VarChar(63)
    name      String   @db.VarChar(255)
    status    String   @default("ACTIVE") @db.VarChar(20) // ACTIVE | SUSPENDED | INACTIVE
    settings  Json     @default("{}")
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    users      User[]
    leads      Lead[]
    clients    Client[]
    products   Product[]
    bulkOrders BulkOrder[]
    invoices   Invoice[]
    payments   Payment[]
    commLogs   CommLog[]
    auditLogs  AuditLog[]

    @@map("tenants")
}

// ── Users ───────────────────────────────────────────────────
model User {
    id           String   @id @default(uuid()) @db.Uuid
    tenantId     String   @map("tenant_id") @db.Uuid
    email        String   @db.VarChar(255)
    passwordHash String?  @map("password_hash") @db.Text
    auth0Sub     String?  @map("auth0_sub") @db.VarChar(255)
    name         String   @db.VarChar(255)
    role         String   @default("TENANT_STAFF") @db.VarChar(30)
    isActive     Boolean  @default(true) @map("is_active")
    createdAt    DateTime @default(now()) @map("created_at")
    updatedAt    DateTime @updatedAt @map("updated_at")

    tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
    refreshTokens RefreshToken[]
    resetTokens   PasswordResetToken[]
    assignedLeads Lead[]               @relation("LeadAssignedTo")
    bulkOrders    BulkOrder[]          @relation("BulkOrderCreator")
    invoices      Invoice[]            @relation("InvoiceCreator")
    payments      Payment[]            @relation("PaymentCreator")
    commLogs      CommLog[]            @relation("CommLogCreator")
    auditLogs     AuditLog[]           @relation("AuditActor")

    @@unique([tenantId, email])
    @@unique([tenantId, auth0Sub])
    @@index([tenantId])
    @@map("users")
}

// ── Auth: Refresh Tokens ────────────────────────────────────
model RefreshToken {
    id        String    @id @default(uuid()) @db.Uuid
    userId    String    @map("user_id") @db.Uuid
    tokenHash String    @map("token_hash") @db.Text
    expiresAt DateTime  @map("expires_at")
    revokedAt DateTime? @map("revoked_at")
    createdAt DateTime  @default(now()) @map("created_at")

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@index([tokenHash])
    @@map("refresh_tokens")
}

// ── Auth: Password Reset Tokens ─────────────────────────────
model PasswordResetToken {
    id        String    @id @default(uuid()) @db.Uuid
    userId    String    @map("user_id") @db.Uuid
    tokenHash String    @map("token_hash") @db.Text
    expiresAt DateTime  @map("expires_at")
    usedAt    DateTime? @map("used_at")
    createdAt DateTime  @default(now()) @map("created_at")

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([tokenHash])
    @@map("password_reset_tokens")
}

// ── Leads ───────────────────────────────────────────────────
model Lead {
    id             String   @id @default(uuid()) @db.Uuid
    tenantId       String   @map("tenant_id") @db.Uuid
    name           String   @db.VarChar(255)
    phone          String?  @db.VarChar(30)
    email          String?  @db.VarChar(255)
    city           String?  @db.VarChar(100)
    instrument     String?  @db.VarChar(100)
    courseInterest String?  @map("course_interest") @db.VarChar(255)
    preferredTime  String?  @map("preferred_time") @db.VarChar(100)
    message        String?  @db.Text
    status         String   @default("NEW") @db.VarChar(20) // NEW | CONTACTED | QUALIFIED | WON | LOST
    source         String?  @db.VarChar(100)
    utm            Json?    @default("{}")
    assignedToId   String?  @map("assigned_to_user_id") @db.Uuid
    createdAt      DateTime @default(now()) @map("created_at")
    updatedAt      DateTime @updatedAt @map("updated_at")

    tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
    assignedTo User?          @relation("LeadAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
    client     Client?        @relation("ConvertedLead")
    activities LeadActivity[]

    @@index([tenantId])
    @@index([tenantId, status])
    @@index([tenantId, assignedToId])
    @@map("leads")
}

// ── Lead Activity Timeline ──────────────────────────────────
model LeadActivity {
    id        String   @id @default(uuid()) @db.Uuid
    leadId    String   @map("lead_id") @db.Uuid
    action    String   @db.VarChar(50) // CREATED | STATUS_CHANGED | ASSIGNED | NOTE_ADDED | CONVERTED
    details   Json?    @default("{}")
    actorId   String?  @map("actor_id") @db.Uuid
    createdAt DateTime @default(now()) @map("created_at")

    lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

    @@index([leadId])
    @@map("lead_activities")
}

// ── Clients / Students ──────────────────────────────────────
model Client {
    id                  String   @id @default(uuid()) @db.Uuid
    tenantId            String   @map("tenant_id") @db.Uuid
    name                String   @db.VarChar(255)
    phone               String?  @db.VarChar(30)
    email               String?  @db.VarChar(255)
    address             String?  @db.Text
    city                String?  @db.VarChar(100)
    instruments         Json?    @default("[]")
    preferences         Json?    @default("{}")
    convertedFromLeadId String?  @unique @map("converted_from_lead_id") @db.Uuid
    createdAt           DateTime @default(now()) @map("created_at")
    updatedAt           DateTime @updatedAt @map("updated_at")

    tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
    convertedFrom Lead?       @relation("ConvertedLead", fields: [convertedFromLeadId], references: [id], onDelete: SetNull)
    bulkOrders    BulkOrder[]
    invoices      Invoice[]

    @@index([tenantId])
    @@map("clients")
}

// ── Products ────────────────────────────────────────────────
model Product {
    id          String   @id @default(uuid()) @db.Uuid
    tenantId    String   @map("tenant_id") @db.Uuid
    type        String   @db.VarChar(30) // COURSE | PACKAGE | INSTRUMENT | SERVICE
    name        String   @db.VarChar(255)
    description String?  @db.Text
    price       Decimal  @db.Decimal(12, 2)
    currency    String   @default("INR") @db.VarChar(3)
    duration    String?  @db.VarChar(100)
    taxRate     Decimal  @default(0) @map("tax_rate") @db.Decimal(5, 2)
    isActive    Boolean  @default(true) @map("is_active")
    createdAt   DateTime @default(now()) @map("created_at")
    updatedAt   DateTime @updatedAt @map("updated_at")

    tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
    bulkOrderItems BulkOrderItem[]
    invoiceItems   InvoiceItem[]

    @@index([tenantId])
    @@index([tenantId, type])
    @@map("products")
}

// ── Bulk Orders ─────────────────────────────────────────────
model BulkOrder {
    id            String   @id @default(uuid()) @db.Uuid
    tenantId      String   @map("tenant_id") @db.Uuid
    clientId      String?  @map("client_id") @db.Uuid
    status        String   @default("DRAFT") @db.VarChar(20) // DRAFT | CONFIRMED | FULFILLED | CANCELLED
    discountTotal Decimal  @default(0) @map("discount_total") @db.Decimal(12, 2)
    taxTotal      Decimal  @default(0) @map("tax_total") @db.Decimal(12, 2)
    grandTotal    Decimal  @default(0) @map("grand_total") @db.Decimal(12, 2)
    createdById   String   @map("created_by") @db.Uuid
    createdAt     DateTime @default(now()) @map("created_at")
    updatedAt     DateTime @updatedAt @map("updated_at")

    tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
    client    Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
    createdBy User            @relation("BulkOrderCreator", fields: [createdById], references: [id])
    items     BulkOrderItem[]

    @@index([tenantId])
    @@map("bulk_orders")
}

model BulkOrderItem {
    id          String  @id @default(uuid()) @db.Uuid
    bulkOrderId String  @map("bulk_order_id") @db.Uuid
    productId   String  @map("product_id") @db.Uuid
    qty         Int
    unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
    discount    Decimal @default(0) @db.Decimal(12, 2)
    tax         Decimal @default(0) @db.Decimal(12, 2)

    bulkOrder BulkOrder @relation(fields: [bulkOrderId], references: [id], onDelete: Cascade)
    product   Product   @relation(fields: [productId], references: [id])

    @@map("bulk_order_items")
}

// ── Invoices ────────────────────────────────────────────────
model Invoice {
    id            String    @id @default(uuid()) @db.Uuid
    tenantId      String    @map("tenant_id") @db.Uuid
    clientId      String    @map("client_id") @db.Uuid
    invoiceNumber String    @map("invoice_number") @db.VarChar(50)
    status        String    @default("DRAFT") @db.VarChar(20) // DRAFT | ISSUED | PAID | VOID | OVERDUE
    issuedAt      DateTime? @map("issued_at")
    dueAt         DateTime? @map("due_at")
    subtotal      Decimal   @default(0) @db.Decimal(12, 2)
    discountTotal Decimal   @default(0) @map("discount_total") @db.Decimal(12, 2)
    taxTotal      Decimal   @default(0) @map("tax_total") @db.Decimal(12, 2)
    total         Decimal   @default(0) @db.Decimal(12, 2)
    notes         String?   @db.Text
    createdById   String    @map("created_by") @db.Uuid
    createdAt     DateTime  @default(now()) @map("created_at")
    updatedAt     DateTime  @updatedAt @map("updated_at")

    tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
    client    Client        @relation(fields: [clientId], references: [id])
    createdBy User          @relation("InvoiceCreator", fields: [createdById], references: [id])
    items     InvoiceItem[]
    payments  Payment[]

    @@unique([tenantId, invoiceNumber])
    @@index([tenantId])
    @@map("invoices")
}

model InvoiceItem {
    id          String  @id @default(uuid()) @db.Uuid
    invoiceId   String  @map("invoice_id") @db.Uuid
    productId   String? @map("product_id") @db.Uuid
    description String  @db.VarChar(500)
    qty         Int
    unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
    discount    Decimal @default(0) @db.Decimal(12, 2)
    tax         Decimal @default(0) @db.Decimal(12, 2)

    invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
    product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

    @@map("invoice_items")
}

// ── Payments ────────────────────────────────────────────────
model Payment {
    id          String   @id @default(uuid()) @db.Uuid
    tenantId    String   @map("tenant_id") @db.Uuid
    invoiceId   String   @map("invoice_id") @db.Uuid
    amount      Decimal  @db.Decimal(12, 2)
    method      String   @db.VarChar(50) // CASH | UPI | CARD | BANK_TRANSFER | CHEQUE | OTHER
    reference   String?  @db.VarChar(255)
    receivedAt  DateTime @map("received_at")
    createdById String   @map("created_by") @db.Uuid
    createdAt   DateTime @default(now()) @map("created_at")

    tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
    invoice   Invoice @relation(fields: [invoiceId], references: [id])
    createdBy User    @relation("PaymentCreator", fields: [createdById], references: [id])

    @@index([tenantId])
    @@index([invoiceId])
    @@map("payments")
}

// ── Communication Logs ──────────────────────────────────────
model CommLog {
    id          String   @id @default(uuid()) @db.Uuid
    tenantId    String   @map("tenant_id") @db.Uuid
    entityType  String   @map("entity_type") @db.VarChar(20) // LEAD | CLIENT
    entityId    String   @map("entity_id") @db.Uuid
    type        String   @db.VarChar(20) // NOTE | CALL | WHATSAPP | EMAIL
    subject     String?  @db.VarChar(500)
    body        String?  @db.Text
    meta        Json?    @default("{}")
    createdById String   @map("created_by") @db.Uuid
    createdAt   DateTime @default(now()) @map("created_at")

    tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
    createdBy User   @relation("CommLogCreator", fields: [createdById], references: [id])

    @@index([tenantId])
    @@index([tenantId, entityType, entityId])
    @@map("comm_logs")
}

// ── Audit Logs ──────────────────────────────────────────────
model AuditLog {
    id         String   @id @default(uuid()) @db.Uuid
    tenantId   String?  @map("tenant_id") @db.Uuid
    actorId    String?  @map("actor_user_id") @db.Uuid
    action     String   @db.VarChar(100)
    entityType String?  @map("entity_type") @db.VarChar(50)
    entityId   String?  @map("entity_id") @db.Uuid
    meta       Json?    @default("{}")
    createdAt  DateTime @default(now()) @map("created_at")

    tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
    actor  User?   @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

    @@index([tenantId])
    @@index([tenantId, action])
    @@map("audit_logs")
}

// ── Contact Messages (public website form, no tenant) ───────
model ContactMessage {
    id        String   @id @default(uuid()) @db.Uuid
    name      String   @db.VarChar(255)
    email     String   @db.VarChar(255)
    phone     String?  @db.VarChar(30)
    subject   String   @db.VarChar(500)
    message   String   @db.Text
    status    String   @default("NEW") @db.VarChar(20) // NEW | READ | REPLIED | CLOSED
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@map("contact_messages")
}
