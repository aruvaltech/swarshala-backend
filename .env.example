# ── App ──────────────────────────────────────────
NODE_ENV=production
PORT=4000
BASE_DOMAIN=swarshala.com
BACKEND_URL=https://api.swarshala.com

# ── Database ─────────────────────────────────────
DATABASE_URL=postgresql://ConductZuperscoreDev:Hello%409090@conduct-zuperscore-dev-cin-001.postgres.database.azure.com:5432/ss?sslmode=require

# ── JWT ──────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ─────────────────────────────────────────
CORS_ORIGINS=https://swarshala.com,https://www.swarshala.com,https://api.swarshala.com,http://localhost:3000

# ── Rate Limiting ────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── Logging ──────────────────────────────────────
LOG_LEVEL=info
